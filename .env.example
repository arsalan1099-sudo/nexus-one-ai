# Public origin must exactly match the browser origin; no trailing slash.
NODE_ENV=production
PORT=3000
# Leave blank on Render to infer https://$RENDER_EXTERNAL_HOSTNAME. Set explicitly for custom domains.
APP_ORIGIN=
# Public Firebase web configuration, all from the SAME Firebase project.
FIREBASE_PROJECT_ID=
FIREBASE_WEB_API_KEY=
FIREBASE_APP_ID=
FIREBASE_AUTH_DOMAIN=
# Mount a Firebase service-account JSON as a secret file outside the public directory.
# Prefer workload identity / application default credentials when the host supports it.
# Option A: mounted file credential (local/Docker Compose)
GOOGLE_APPLICATION_CREDENTIALS=
# Option B: base64 of the Firebase Admin JSON, as a secret ENV var in Render.
# Use exactly one of these methods; never commit its value.
FIREBASE_ADMIN_JSON_B64=
# Secret key, only on backend. Provider requests may cost money.
POLLINATIONS_API_KEY=
# Select supported model IDs from https://gen.pollinations.ai/models
TEXT_MODEL=openai/gpt-5.4-nano
IMAGE_MODEL=black-forest-labs/flux.1-schnell
# Dedicated persistent Redis, internal/private connection or TLS for remote access.
REDIS_URL=redis://redis:6379
# Allowlist is the secure default. Set ACCESS_POLICY=verified ONLY for a controlled
# citizen beta after configuring global quotas and monitoring provider billing.
# In verified mode, any verified-email Firebase user can use AI within quotas.
ACCESS_POLICY=allowlist
# Comma-separated Firebase UIDs for allowlist mode. Never use a wildcard.
ALLOWED_UIDS=
# Global UTC fixed-day request ceiling, not a currency spending guarantee.
DAILY_REQUEST_LIMIT=100
USER_MINUTE_LIMIT=5

# Extra per-account cost controls. Quotas use fixed 24-hour windows.
IMAGE_DAILY_LIMIT=10
PROJECT_DAILY_LIMIT=10
# Default 0 ignores X-Forwarded-For. Set to 1 ONLY behind exactly one trusted,
# ingress-controlled proxy that overwrites X-Forwarded-For. Do not expose the app directly.
TRUST_PROXY_HOPS=0

# Multimodal vision must be supported by this model. Use public model catalog to verify.
VISION_MODEL=openai/gpt-5.4-nano
VISION_DAILY_LIMIT=10
