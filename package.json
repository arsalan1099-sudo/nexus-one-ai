{
  "name": "nexus-asi-elite",
  "version": "1.3.0-citizen-astra.1",
  "description": "NEXUS Citizen Edition: Astra-inspired multimodal citizen assistant, secure chat and local tools",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "build": "node scripts/build.js && node scripts/build-citizen.mjs",
    "start": "node --env-file-if-exists=.env src/server.js",
    "test": "node --test test/*.test.js",
    "check": "npm run build && npm test",
    "audit": "npm audit --omit=dev",
    "test:browser": "node scripts/browser-test.js",
    "browser:install": "playwright install chromium",
    "preflight": "node --env-file-if-exists=.env scripts/preflight.js",
    "verify:offline": "node scripts/rc4-verify.mjs",
    "verify:astra": "node scripts/rc7-verify.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "type": "module",
  "dependencies": {
    "@firebase/app-compat": "0.5.20",
    "@firebase/auth-compat": "0.6.13",
    "express": "5.3.0",
    "firebase-admin": "14.5.0",
    "jszip": "3.10.2",
    "redis": "6.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "playwright": "1.56.1",
    "supertest": "7.3.1"
  },
  "private": true,
  "engines": {
    "node": ">=24 <25"
  }
}
